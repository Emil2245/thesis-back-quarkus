# Postgres — override in local .env or hosting provider secrets.
DB_URL=jdbc:postgresql://localhost:5432/propuestas
DB_USER=propuestas
DB_PASSWORD=change-me

# JWT — dev: scripts/gen-jwt-keys.sh (-> .secrets/jwt/); prod: Secret montado en /etc/propuestas/jwt/.
# NUNCA commitear claves reales.
JWT_PRIVATE_KEY_LOCATION=file:.secrets/jwt/privateKey.pem
JWT_PUBLIC_KEY_LOCATION=file:.secrets/jwt/publicKey.pem
JWT_ISSUER=https://propuestas-api.local

# CORS / observabilidad
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SDK_DISABLED=true

# Display precision (presentation only)
DISPLAY_PRECISION=2
DISPLAY_PRECISION_PORCENTAJE=4

# Puerto HTTP del backend (default 8080 si no se define en application.yml)
QUARKUS_HTTP_PORT=8080

# Correo (Plan 024). Por defecto MAIL_MODE=log: no se envía nada.
# Para enviar por SMTP descomentar y completar (placeholders):
# MAIL_MODE=smtp
# QUARKUS_MAILER_HOST=smtp.example.invalid
# QUARKUS_MAILER_PORT=587
# QUARKUS_MAILER_USERNAME=usuario-smtp
# QUARKUS_MAILER_PASSWORD=cambiar-por-secreto
# QUARKUS_MAILER_FROM=noreply@example.invalid
# QUARKUS_MAILER_START_TLS=REQUIRED
# URL pública del frontend, base de los enlaces de los correos
# APP_FRONTEND_BASE_URL=https://app.example.invalid
