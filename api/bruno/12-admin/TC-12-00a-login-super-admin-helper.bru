meta {
  name: TC-12-00a-login-super-admin-helper
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "recordarSesion": true
  }
}

script:post-response {
  if (res.status !== 200) throw new Error("SUPER_ADMIN login failed");
  bru.setVar("admin_access_token", res.body.accessToken);
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
}
