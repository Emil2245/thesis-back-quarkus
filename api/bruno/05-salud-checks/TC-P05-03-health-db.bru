meta {
  name: TC-P05-03 — DB health check
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/q/health/ready/db
  auth: none
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("DB is UP", function() {
    expect(res.body.status).to.equal("UP");
  });
}
