meta {
  name: TC-P05-02 — Readiness check (DB)
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/q/health/ready
  auth: none
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Status is UP", function() {
    expect(res.body.status).to.equal("UP");
  });
}
