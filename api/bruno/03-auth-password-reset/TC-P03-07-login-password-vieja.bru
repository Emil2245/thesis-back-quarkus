meta {
  name: TC-P03-07 — Login con password vieja
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{u1Email}}",
    "password": "{{u1Password}}",
    "recordarSesion": true
  }
}

tests {
  test("Status 401 Unauthorized (password vieja no funciona)", function() {
    expect(res.status).to.equal(401);
  });

  test("Error: credenciales-invalidas", function() {
    expect(res.body.codigo).to.equal("credenciales-invalidas");
  });
}
