meta {
  name: TC-P03-04 — Passwords no coinciden
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/restablecer
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{u1_token_reset}}",
    "password": "{{u1PasswordNueva}}",
    "passwordConfirmacion": "OtraClave999"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
