meta {
  name: TC-P03-05 — Password débil
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/restablecer
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{u1_token_reset}}",
    "password": "corta",
    "passwordConfirmacion": "corta"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
