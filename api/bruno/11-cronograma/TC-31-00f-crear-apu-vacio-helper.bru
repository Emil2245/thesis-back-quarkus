meta {
  name: TC-31-00f — Crear APU vacío (helper)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/presupuestos/{{p31PresupuestoId}}/apus
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "codigo": "APU-P31-VACIO-01",
    "descripcion": "APU vacío Plan 031 — usado por TC-31-00h / casos positivos",
    "unidad": "u"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("p31ApuVacioId", res.body.id);
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("APU creado con 4 secciones M/N/O/P vacías", function() {
    expect(res.body.secciones.length).to.equal(4);
  });

  test("apuId UUIDv7 capturado", function() {
    expect(res.body.id).to.match(/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$/);
  });

  test("codigo determinista APU-P31-VACIO-01", function() {
    expect(res.body.codigo).to.equal("APU-P31-VACIO-01");
  });
}

docs {
  Helper de Plan 031 — crea un APU sin plantilla, sin filas, con código
  determinista `APU-P31-VACIO-01`. La colección asume una BD limpia
  por corrida; sobre una BD reutilizada el código puede colisionar.
  Se consume en `TC-31-00h` (crear rubro bajo capítulo raíz).
  Importante: inmediatamente después de este helper se ejecutan
  `TC-31-00f2` (crear insumo MATERIAL) y `TC-31-00f3` (agregar el
  insumo como detalle al APU) para que el PU del APU/rubro sea > 0;
  sin ellos, los casos positivos (`TC-31-01`, `TC-31-05/06/07`)
  fallarían por la regla P-32 `presupuesto-pu-cero`.
  Misma forma que `TC-10-00e` (Presupuesto P-25) — reutilizado.
}
