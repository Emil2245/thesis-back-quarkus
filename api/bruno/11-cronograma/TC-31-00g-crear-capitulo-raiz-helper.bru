meta {
  name: TC-31-00g — Crear capítulo raíz P-28 (helper)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/presupuestos/{{p31PresupuestoId}}/capitulos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "descripcion": "OBRAS PRELIMINARES Plan031"
  }
}

script:post-response {
  if (res.status === 201 && res.body && Array.isArray(res.body.capitulos)
      && res.body.capitulos.length > 0) {
    bru.setVar("p31CapituloRaizId", res.body.capitulos[0].id);
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Item del capítulo raíz es '1' (jerarquía autogenerada)", function() {
    expect(res.body.capitulos[0].item).to.equal("1");
  });

  test("capituloId UUIDv7 capturado", function() {
    expect(res.body.capitulos[0].id).to.match(/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$/);
  });

  test("Sin rubros iniciales", function() {
    expect(res.body.capitulos[0].rubros).to.be.an("array");
    expect(res.body.capitulos[0].rubros.length).to.equal(0);
  });
}

docs {
  Helper de Plan 031 — crea un capítulo raíz vía
  `POST /presupuestos/{presupuestoId}/capitulos`. El backend asigna
  `item = '1'` (orden implícito 1). Misma forma que `TC-10-02a`
  (reutilizado por Plan 031). Consumido por `TC-31-00h`.
}
