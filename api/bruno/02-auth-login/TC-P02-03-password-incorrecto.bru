meta {
  name: TC-P02-03 — Login password incorrecto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{u1Email}}",
    "password": "WrongPassword99",
    "recordarSesion": false
  }
}

tests {
  test("Status 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error: credenciales-invalidas", function() {
    expect(res.body.codigo).to.equal("credenciales-invalidas");
  });
}
