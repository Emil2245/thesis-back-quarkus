meta {
  name: TC-P02-07 — Refresh token viejo (rotación)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{u1_refresh_token_viejo}}"
  }
}

tests {
  test("Status 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error: token-invalido-o-expirado", function() {
    expect(res.body.codigo).to.equal("token-invalido-o-expirado");
  });
}
