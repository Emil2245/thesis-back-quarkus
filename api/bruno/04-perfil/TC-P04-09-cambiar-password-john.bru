meta {
  name: TC-P04-09 — John cambia password
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "passwordActual": "{{u1Password}}",
    "passwordNueva": "{{u1PasswordNueva}}",
    "passwordConfirmacion": "{{u1PasswordNueva}}"
  }
}

tests {
  test("Status 204 No Content", function() {
    expect(res.status).to.equal(204);
  });
}
