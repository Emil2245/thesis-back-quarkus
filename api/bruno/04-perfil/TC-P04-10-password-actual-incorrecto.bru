meta {
  name: TC-P04-10 — Password actual incorrecto
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "passwordActual": "WrongPassword99",
    "passwordNueva": "OtraClave123",
    "passwordConfirmacion": "OtraClave123"
  }
}

tests {
  test("Status 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error: credenciales-invalidas", function() {
    expect(res.body.codigo).to.equal("credenciales-invalidas");
  });
}
