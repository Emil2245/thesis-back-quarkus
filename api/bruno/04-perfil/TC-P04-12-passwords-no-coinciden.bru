meta {
  name: TC-P04-12 — Passwords nuevas no coinciden
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "passwordActual": "{{u1PasswordNueva}}",
    "passwordNueva": "NuevaClave789",
    "passwordConfirmacion": "OtraClave456"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
