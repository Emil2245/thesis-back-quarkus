meta {
  name: TC-P04-13 — Ana cambia password
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "passwordActual": "{{u2Password}}",
    "passwordNueva": "{{u2PasswordNueva}}",
    "passwordConfirmacion": "{{u2PasswordNueva}}"
  }
}

tests {
  test("Status 204 No Content", function() {
    expect(res.status).to.equal(204);
  });
}
