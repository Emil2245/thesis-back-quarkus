meta {
  name: TC-P04-17 — Verificar perfil Ana actualizado
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/perfil
  auth: bearer
}

auth:bearer {
  token: {{u2_access_token}}
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Nombre actualizado", function() {
    expect(res.body.nombre).to.equal("Ana de Armas Updated");
  });
}
