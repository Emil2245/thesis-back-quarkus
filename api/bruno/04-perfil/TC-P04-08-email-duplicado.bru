meta {
  name: TC-P04-08 — John email duplicado (usa email de Ana)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/perfil
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "John Doe",
    "email": "{{u2Email}}"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
