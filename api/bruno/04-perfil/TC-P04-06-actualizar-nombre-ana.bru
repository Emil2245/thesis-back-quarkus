meta {
  name: TC-P04-06 — Ana actualiza nombre
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/perfil
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Ana de Armas Updated",
    "email": "{{u2Email}}"
  }
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Nombre actualizado", function() {
    expect(res.body.nombre).to.equal("Ana de Armas Updated");
  });
}
