meta {
  name: TC-P04-14 — Login John con password nueva
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{u1Email}}",
    "password": "{{u1PasswordNueva}}",
    "recordarSesion": true
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("u1_access_token", res.body.accessToken);
    bru.setVar("u1_refresh_token", res.body.refreshToken);
  }
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
}
