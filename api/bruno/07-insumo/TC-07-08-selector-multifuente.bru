meta {
  name: TC-07-08 — Selector multi-fuente (P-16/P-21)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/proyectos/{{proyectoId}}/insumos/selector?q=&soloCentrales=false&page=0&size=25
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Resultados con fuente", function() {
    expect(res.body.items).to.be.an("array");
    if (res.body.items.length > 0) {
      expect(res.body.items[0]).to.have.property("fuente");
    }
  });
}
