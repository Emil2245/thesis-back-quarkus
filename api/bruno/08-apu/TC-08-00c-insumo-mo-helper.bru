meta {
  name: TC-08-00c — Insumo MO semilla (helper)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/proyectos/{{proyectoId}}/insumos?tipo=MANO_OBRA&q=MO-001
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
  if (res.status === 200 && res.body.items && res.body.items.length > 0) {
    bru.setVar("insumoMoId", res.body.items[0].id);
  }
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Insumo MO semilla encontrado", function() {
    expect(res.body.items.length).to.be.greaterThan(0);
  });
}