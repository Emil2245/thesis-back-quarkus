meta {
  name: TC-08-08 — PrecioOverride null restaura herencia (P-22)
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/apus/{{apuId}}/detalles/{{filaMoId}}
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
    "precioOverride": null
  }
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Vuelve a heredar el precio del insumo (4.75)", function() {
    var detalle = res.body.secciones[1].detalles.find(function(d) {
      return d.id === bru.getVar("filaMoId");
    });
    expect(detalle).to.not.be.null;
    expect(detalle.precioEfectivo).to.equal(4.75);
    expect(detalle.precioHeredado).to.equal(true);
  });
}