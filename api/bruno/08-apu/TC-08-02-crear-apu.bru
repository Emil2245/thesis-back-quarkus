meta {
  name: TC-08-02 — Crear APU (P-20), 4 secciones + fila HM
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/presupuestos/{{presupuestoId}}/apus
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
    "codigo": "BR-APU-001",
    "descripcion": "APU de prueba Bruno",
    "unidad": "m2"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("apuId", res.body.id);
    if (res.body.secciones && res.body.secciones[0] && res.body.secciones[0].detalles
        && res.body.secciones[0].detalles.length > 0) {
      bru.setVar("hmDetalleId", res.body.secciones[0].detalles[0].id);
    }
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("4 secciones en orden M/N/O/P", function() {
    expect(res.body.secciones.length).to.equal(4);
    expect(res.body.secciones[0].tipo).to.equal("EQUIPO");
    expect(res.body.secciones[1].tipo).to.equal("MANO_OBRA");
    expect(res.body.secciones[2].tipo).to.equal("MATERIAL");
    expect(res.body.secciones[3].tipo).to.equal("TRANSPORTE");
  });

  test("Fila HM automática en EQUIPO", function() {
    expect(res.body.secciones[0].detalles.length).to.equal(1);
    expect(res.body.secciones[0].detalles[0].esHerramientaMenor).to.equal(true);
    expect(res.body.secciones[0].detalles[0].cantidad).to.equal(null);
  });
}