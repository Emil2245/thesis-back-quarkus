meta {
  name: TC-P01-04 — Password sin números
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Test Sin Numero",
    "email": "test-sin-numero@uce.edu.ec",
    "password": "SoloLetras",
    "passwordConfirmacion": "SoloLetras"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
