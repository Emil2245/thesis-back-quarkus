meta {
  name: TC-P01-03 — Email duplicado
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "{{u1Nombre}}",
    "email": "{{u1Email}}",
    "password": "{{u1Password}}",
    "passwordConfirmacion": "{{u1Password}}"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
