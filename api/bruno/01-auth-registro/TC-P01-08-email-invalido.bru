meta {
  name: TC-P01-08 — Email inválido
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Test Email Malo",
    "email": "no-es-email",
    "password": "Clave1234",
    "passwordConfirmacion": "Clave1234"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
