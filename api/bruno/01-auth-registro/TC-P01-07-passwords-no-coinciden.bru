meta {
  name: TC-P01-07 — Passwords no coinciden
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Test No Coincide",
    "email": "test-no-coincide@uce.edu.ec",
    "password": "Clave1234",
    "passwordConfirmacion": "Clave5678"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
