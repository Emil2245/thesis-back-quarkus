meta {
  name: TC-P01-06 — Password sin letras
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Test Sin Letras",
    "email": "test-sin-letras@uce.edu.ec",
    "password": "12345678",
    "passwordConfirmacion": "12345678"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
