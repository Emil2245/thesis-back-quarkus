meta {
  name: TC-P01-05 — Password muy corta
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Test Corta",
    "email": "test-corta@uce.edu.ec",
    "password": "Ab1",
    "passwordConfirmacion": "Ab1"
  }
}

tests {
  test("Status 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error: validacion", function() {
    expect(res.body.codigo).to.equal("validacion");
  });
}
