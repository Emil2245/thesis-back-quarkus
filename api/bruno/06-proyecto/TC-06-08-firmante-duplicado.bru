meta {
  name: TC-06-08 — Firmante duplicado (rol+orden) → 400
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/proyectos/{{proyectoId}}/firmantes
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
    "nombre": "Otro Firmante",
    "cargo": "Inspector",
    "rol": "CONSOLIDADO",
    "orden": 1
  }
}

tests {
  test("Status 400 validacion", function() {
    expect(res.status).to.equal(400);
    expect(res.body.codigo).to.equal("validacion");
  });
}
