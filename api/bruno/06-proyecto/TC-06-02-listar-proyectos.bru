meta {
  name: TC-06-02 — Listar proyectos del usuario
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/proyectos?page=0&size=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Respuesta paginada", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.at.least(1);
  });
}
