meta {
  name: TC-09-11e — Crear hoja profunda para Plan 005 (helper)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/presupuestos/{{p05PresupuestoId}}/capitulos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "descripcion": "Plan 005 hoja",
    "parentId": "{{p05CapituloRaizId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.capitulos
      && res.body.capitulos.length > 0
      && res.body.capitulos[0].subcapitulos
      && res.body.capitulos[0].subcapitulos.length > 0) {
    var hoja = res.body.capitulos[0].subcapitulos[0];
    bru.setVar("p05CapituloHojaId", hoja.id);
    bru.setVar("p05CapituloHojaItem", hoja.item);
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Hoja profunda creada como 1.1", function() {
    expect(res.body.capitulos[0].subcapitulos[0].item).to.equal("1.1");
    expect(res.body.capitulos[0].subcapitulos[0].id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
  });
}

docs {
  Helper Plan 005 — deja una hoja profunda explícita y captura su UUIDv7 e
  item para verificar tanto el destino implícito como el capítulo explícito.
}
