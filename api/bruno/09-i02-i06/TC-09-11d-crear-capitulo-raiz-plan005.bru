meta {
  name: TC-09-11d — Crear capítulo raíz para Plan 005 (helper)
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/presupuestos/{{p05PresupuestoId}}/capitulos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "descripcion": "Plan 005 raíz"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.capitulos
      && res.body.capitulos.length > 0) {
    bru.setVar("p05CapituloRaizId", res.body.capitulos[0].id);
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Capítulo raíz creado con item 1", function() {
    expect(res.body.capitulos[0].item).to.equal("1");
    expect(res.body.capitulos[0].id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
  });
}

docs {
  Helper Plan 005 — crea un capítulo raíz en la versión nueva para que el
  destino implícito del lote tenga una hoja determinista.
}
