meta {
  name: TC-09-07b — Leer Especificación Técnica del APU (GET)
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/apus/{{apuId}}/especificacion-tecnica
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("apuId es UUIDv7 y contenido presente", function() {
    expect(res.body.apuId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
    expect(res.body.contenido).to.be.a("string");
    expect(res.body.contenido.length).to.be.at.least(1);
  });
}

docs {
  Caso Plan 08 #6 (ET + títulos) — parte B: GET de la ET persistida
  por TC-09-07a. Forma estable: `{ apuId: UUID, contenido: string }`.
  El cliente puede renderizar el texto plano tal cual, o volver a
  envolverlo en un editor rich-text (es responsabilidad del frontend
  reconstruir el markup si lo hubo).
}