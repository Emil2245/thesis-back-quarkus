meta {
  name: TC-09-00b — Proyecto EN_PROCESO seed (helper)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/proyectos?q=Rehabilitaci%C3%B3n
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
  // Captura el el el public_id UUIDv7 del proyecto "Rehabilitación de
  // consultorios UCE" (V004 EN_PROCESO, id interno 2). El seed fija
  // 0192f6c4-7c8a-7abc-8000-000000001102 pero se valida contra el
  // backend para no asumir el layout.
  if (res.status === 200 && res.body && res.body.items) {
    var seed = res.body.items.find(function(p) {
      return p.nombreProyecto === "Rehabilitación de consultorios UCE";
    });
    if (seed) {
      bru.setVar("proyectoEnProcesoId", seed.id);
    }
  }
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Proyecto EN_PROCESO seed presente", function() {
    expect(res.body.items).to.satisfy(function(items) {
      return items.some(function(p) {
        return p.nombreProyecto === "Rehabilitación de consultorios UCE";
      });
    });
  });
}

docs {
  Helper de Plan 08 — captura el public_id UUIDv7 del proyecto
  EN_PROCESO usado por TC-09-04 (plantilla APU), TC-09-05
  (reordenamiento) y TC-09-06 (desglose). El valor
  `0192f6c4-7c8a-7abc-8000-000000001102` es el public_id del seed V004
  (plantilla "Rehabilitación de consultorios UCE", usuario John Doe).
}