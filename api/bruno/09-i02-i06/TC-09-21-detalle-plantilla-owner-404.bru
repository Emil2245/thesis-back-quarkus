get {
  url: {{baseUrl}}/plantillas-apu/{{nuevaPlantillaApuId}}
  auth: bearer
}

auth:bearer {
  token: {{u2_access_token}}
}

tests {
  test("PERSONAL ajena devuelve 404", function() {
    expect(res.status).to.equal(404);
    expect(res.body.codigo).to.equal("no-encontrado");
  });
}

